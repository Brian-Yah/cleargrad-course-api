{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleargrad.app/schemas/course-api/v1/course.schema.json",
  "title": "NSYSUCourseAPI-compatible course row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "url",
    "change",
    "changeDescription",
    "multipleCompulsory",
    "department",
    "id",
    "grade",
    "class",
    "name",
    "credit",
    "yearSemester",
    "compulsory",
    "restrict",
    "select",
    "selected",
    "remaining",
    "teacher",
    "room",
    "classTime",
    "description",
    "tags",
    "english"
  ],
  "properties": {
    "url": { "type": "string", "format": "uri" },
    "change": { "type": ["string", "null"] },
    "changeDescription": { "type": ["string", "null"] },
    "multipleCompulsory": { "type": "boolean" },
    "department": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "grade": { "type": "string" },
    "class": { "type": ["string", "null"] },
    "name": { "type": "string", "minLength": 1 },
    "credit": { "type": ["string", "number"] },
    "yearSemester": { "type": "string", "enum": ["年", "期"] },
    "compulsory": { "type": "boolean" },
    "restrict": { "type": "integer", "minimum": 0 },
    "select": { "type": "integer", "minimum": 0 },
    "selected": { "type": "integer", "minimum": 0 },
    "remaining": { "type": "integer" },
    "teacher": { "type": "string" },
    "room": { "type": "string" },
    "classTime": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "string" }
    },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "english": { "type": "boolean" }
  }
}

